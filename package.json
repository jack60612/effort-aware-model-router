{
	"type": "module",
	"name": "effort-aware-model-router",
	"version": "0.2.0",
	"description": "Effort-aware model routing extension for omp",
	"homepage": "https://omp.sh",
	"author": "Derek Rynd",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jack60612/effort-aware-model-router.git"
	},
	"bugs": {
		"url": "https://github.com/jack60612/effort-aware-model-router/issues"
	},
	"keywords": [
		"model-routing",
		"agent",
		"extension"
	],
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-ai": "^17.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@oh-my-pi/pi-coding-agent": "^17.2.4",
		"@types/bun": "^1.3.14",
		"@typescript/native-preview": "7.0.0-dev.20260707.2"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^17.2.4"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	]
}
